{
  "name": "@telepix-lab/mapix",
  "version": "0.1.0",
  "description": "A mapbox-gl toolkit: AOI drawing (rectangle/polygon with self-intersection detection), a map compare slider, and geospatial file parsing (GeoJSON/KML/Shapefile).",
  "license": "MIT",
  "author": "TelePIX",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "mapbox-gl",
    "mapbox-gl-draw",
    "aoi",
    "draw",
    "polygon",
    "rectangle",
    "geojson",
    "kml",
    "shapefile",
    "map-compare",
    "geospatial"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telepix-lab/mapix.git"
  },
  "homepage": "https://github.com/telepix-lab/mapix#readme",
  "bugs": {
    "url": "https://github.com/telepix-lab/mapix/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@mapbox/mapbox-gl-draw": "^1.4.0",
    "mapbox-gl": "^3.0.0"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "@types/geojson": "^7946.0.0",
    "@xmldom/xmldom": "^0.9.10",
    "jszip": "^3.10.1",
    "shpjs": "^6.1.0"
  },
  "devDependencies": {
    "@mapbox/mapbox-gl-draw": "^1.5.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/shpjs": "^3.4.7",
    "mapbox-gl": "^3.13.0",
    "tsup": "^8.5.0",
    "typescript": "5.8.2"
  }
}
